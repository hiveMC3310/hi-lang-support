{
  "comments": {
    "lineComment": "//",
    "docComment": "///"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(IF|ELSE|WHILE|FOR|FUNC|IMPORT)\\b.*$",
    "decreaseIndentPattern": "^\\s*(END|NEXT|ELSE)\\b"
  },
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*",
  "folding": {
    "markers": {
      "start": "^\\s*(IF|WHILE|FOR|FUNC|IMPORT)\\b",
      "end": "^\\s*(END|NEXT)\\b"
    }
  }
}