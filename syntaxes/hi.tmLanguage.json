{
  "name": "Hi",
  "scopeName": "source.hi",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#function-call" },
    { "include": "#builtins" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.hi",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.line.double-slash.doc.hi",
          "begin": "///",
          "end": "$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.hi",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.hi",
          "match": "\\\\(n|r|t|\\\\|\"|u\\{[0-9A-Fa-f]+\\})"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.hi",
      "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.hi",
          "match": "\\b(LET|INPUT|IF|THEN|ELSE|END|WHILE|DO|FOR|TO|NEXT|FUNC|RET|BREAK|PRINT|IMPORT|AS|TRUE|FALSE|AND|OR|NOT)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.hi",
          "match": "(\\+|-|\\*|/|%|\\^|==|!=|>=|<=|>|<|=)"
        },
        {
          "name": "keyword.operator.assignment.hi",
          "match": "(\\+=|-=|\\*=|/=|%=|\\^=)"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.hi",
          "match": "\\b(hello|len|append|insert|remove|contains|indexof|concat|slice|reverse|put|get|keys|values|tostring|toint|tofloat|typeof|call|print|input)\\b"
        },
        {
          "name": "support.constant.builtin.hi",
          "match": "\\b(PI|E|ARGS|ARGS_DICT)\\b"
        },
        {
          "name": "support.module.hi",
          "match": "\\b(math|strings|io|collections|json|os|datetime|random|regex|path):"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "name": "meta.function-call.hi",
          "begin": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "beginCaptures": {
            "1": { "name": "entity.name.function.hi" }
          },
          "end": "(?<=\\))\\s*",
          "patterns": [
            { "include": "#expressions" }
          ]
        }
      ]
    },
    "expressions": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#operators" },
        { "include": "#function-call" },
        { "include": "#builtins" },
        { "include": "#identifiers" }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.hi",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}